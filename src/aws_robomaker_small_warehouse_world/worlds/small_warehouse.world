<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <world name="small_warehouse_world">

    <!-- 1. 물리 엔진 파라미터 (Gazebo Harmonic 표준 DART 백엔드 최적화) -->
    <physics default="true" name="dart_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <!-- 2. Gazebo Harmonic 필수 시스템 플러그인 구성 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- 3. 환경 조명 및 씬 설정 (Z-fighting 제거 및 렌더링 비용 최적화) -->
    <scene>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <background>0.35 0.35 0.35 1.0</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <!-- 균일한 조도를 위한 지향성 천장 조명 -->
    <light name="warehouse_ambient_directional" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <direction>0.1 0.1 -1.0</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- 4. GUI 초기 시점 설정 (카메라 뷰포트 클리핑 보정) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-4.70385 10.895 16.2659 0 0.921795 -1.12701</pose>
        <projection_type>perspective</projection_type>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
    </gui>

    <!-- 5. 환경 정적 모델 (SDFormat 1.9 First-class Include 표준) -->

    <!-- 상단 시야 확보를 위해 지붕(Roof)은 기본 주석 처리 유지 -->
    <!--
    <include>
      <uri>model://aws_robomaker_warehouse_RoofB_01</uri>
      <name>aws_robomaker_warehouse_RoofB_01_001</name>
      <pose>0.0 0.0 0 0 0 0</pose>
      <static>true</static>
    </include>
    -->

    <!-- 외벽 및 바닥 -->
    <include>
      <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      <name>aws_robomaker_warehouse_WallB_01_001</name>
      <pose>0.0 0.0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
      <name>aws_robomaker_warehouse_GroundB_01_001</name>
      <pose>0.0 0.0 -0.090092 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- 선반 (Shelves) -->
    <include>
      <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      <name>aws_robomaker_warehouse_ShelfF_01_001</name>
      <pose>-5.795143 -0.956635 0 0 0 0</pose>
      <static>true</static>
    </include>

