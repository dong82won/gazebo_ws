<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <world name="small_warehouse_world">

    <!-- 1. 물리 엔진 파라미터 (Gazebo Harmonic / DART 및 ODE 호환) -->
    <physics default="0" name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <!-- 2. Gazebo Sim 필수 시스템 플러그인 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- 3. 환경 조명 및 씬 설정 (그림자 연산 최적화) -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.3 0.3 0.3 1.0</background>
      <shadows>false</shadows>
    </scene>

    <light name="Warehouse_CeilingLight_003" type="point">
      <pose>0 0 9 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>80</range>
        <constant>0.3</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- 4. GUI 초기 시점 설정 (작업 영역 전체 조망) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-4.70385 10.895 16.2659 0 0.921795 -1.12701</pose>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- 5. 환경 정적 모델 (SDFormat 1.9 인클루드 표준 준수) -->

    <!-- 상단 시야 확보를 위해 지붕(Roof)은 기본 주석 처리 (천장 반사 테스트 필요 시 주석 해제) -->
    <!--
    <include>
      <uri>model://aws_robomaker_warehouse_RoofB_01</uri>
      <name>aws_robomaker_warehouse_RoofB_01_001</name>
      <pose>0.0 0.0 0 0 0 0</pose>
      <static>true</static>
    </include>
    -->

    <include>
      <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      <name>aws_robomaker_warehouse_WallB_01_001</name>
      <pose>0.0 0.0 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
      <name>aws_robomaker_warehouse_GroundB_01_001</name>
      <pose>0.0 0.0 -0.090092 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- 랙 및 보관 선반 (Shelf) -->
    <include>
